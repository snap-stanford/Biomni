# ==========================================================
# Biomni_molecule Specific - Large File Defense
# ==========================================================

# 拦截所有常见的模型权重格式
*.pth
*.pt
*.bin
*.ckpt
*.h5
*.weights
*.onnx

# 拦截大型数据格式
*.pkl
*.npy
*.npz
*.sqlite
*.db

# 针对你提到的具体工具模型路径 (加强拦截)
**/chemprop_model/
**/scscore/
**/models/
**/checkpoints/
**/weights/

# 拦截可能产生的巨型日志或压缩包
*.zip
*.tar.gz
*.7z
*.log
*.pstat

# 确保个人敏感配置不上传
.env
.env.*